@model Department

<form  asp-action="SaveAdd" asp-controller="Department" method="post">
    <label>Name</label>
    <input type="text" name="Name" value="@Model?.Name" class="form-control"/>

    <label>Manger Name</label>

    <input type="text" asp-for="Name" class="form-control"/>

    @* @Html.Label("Name")
    @Html.TextBox("Name") *@

    <br />
    @Html.LabelFor(d=>d.Name) 
    
    @Html.TextBoxFor(d=>d.Name, new{@class= "form-control"})

    @Html.LabelFor(d => d.MangerName)

    @Html.TextBoxFor(d => d.MangerName, new { @class = "form-control" })


    <input type="submit" value="Add" />

</form>